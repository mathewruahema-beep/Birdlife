<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Reusable subflow: creates a new npsp__Address__c on the supporter's Household Account and marks it default, so NPSP propagates the change to all household members and address history is preserved. Never edits Contact.MailingAddress directly (Household Account model). DESIGN BUILD - deployed as Draft, do not activate without UAT.</description>
    <environments>Default</environments>
    <interviewLabel>SC NPSP Address Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SC NPSP Address Change</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Household_Address</name>
        <label>Create Household Address</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <inputAssignments>
            <field>npsp__Default_Address__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>npsp__Household_Account__c</field>
            <value>
                <elementReference>varHouseholdAccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>npsp__MailingCity__c</field>
            <value>
                <elementReference>varCity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>npsp__MailingPostalCode__c</field>
            <value>
                <elementReference>varPostalCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>npsp__MailingState__c</field>
            <value>
                <elementReference>varState</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>npsp__MailingStreet__c</field>
            <value>
                <elementReference>varStreet</elementReference>
            </value>
        </inputAssignments>
        <object>npsp__Address__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Household_Address</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>varCity</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varHouseholdAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varPostalCode</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varState</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varStreet</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
