    <decisions>
        <name>Check_Eligibility</name>
        <label>Eligible for acknowledgement?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Not eligible</defaultConnectorLabel>
        <rules>
            <name>Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_GE_RecordType.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fEligibleOrigin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SuppliedEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Do_Not_Email__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IsEmailBounce__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Classify</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Classify</name>
        <label>Classify enquiry</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <defaultConnector>
            <targetReference>Send_Acknowledgement</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No confident match</defaultConnectorLabel>
        <rules>
            <name>R_Update_Details</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsUpdateDetails</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Update_Details</targetReference>
            </connector>
            <label>Update contact details</label>
        </rules>
        <rules>
            <name>R_Receipt</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsReceipt</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Receipt</targetReference>
            </connector>
            <label>Receipt enquiry</label>
        </rules>
        <rules>
            <name>R_Unsubscribe</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsUnsubscribe</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Unsubscribe</targetReference>
            </connector>
            <label>Unsubscribe</label>
        </rules>
    </decisions>
    <description>Intake automation for General Enquiry (Supporter Care) cases created by email or web: sends an instant acknowledgement with the case number and proposes Type / Sub Type from subject and body keywords. Suppressed for bounce, Do Not Email, and cases with no supplied email. DESIGN BUILD - deployed as Draft, do not activate without UAT.</description>
    <environments>Default</environments>
    <formulas>
        <name>fAckSubject</name>
        <dataType>String</dataType>
        <expression>"We have received your enquiry (Case " &amp; {!$Record.CaseNumber} &amp; ")"</expression>
    </formulas>
    <formulas>
        <name>fEligibleOrigin</name>
        <dataType>Boolean</dataType>
        <expression>OR(TEXT({!$Record.Origin}) = "Email", TEXT({!$Record.Origin}) = "Web")</expression>
    </formulas>
    <formulas>
        <name>fIsReceipt</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "receipt"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "tax statement")
)</expression>
    </formulas>
    <formulas>
        <name>fIsUnsubscribe</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "unsubscribe"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "remove me from"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "stop sending")
)</expression>
    </formulas>
    <formulas>
        <name>fIsUpdateDetails</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "change of address"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "change my address"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "update my address"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "new address"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "update my details"),
  CONTAINS(LOWER({!$Record.Subject} &amp; " " &amp; {!$Record.Description}), "update my contact details")
)</expression>
    </formulas>
    <interviewLabel>SC Case Intake {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SC Case Intake - Acknowledge and Classify</label>
    <processType>AutoLaunchedFlow</processType>
