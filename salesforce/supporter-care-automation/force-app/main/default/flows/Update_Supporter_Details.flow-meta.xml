    <screens>
        <name>Screen_Done</name>
        <label>Done</label>
        <locationX>176</locationX>
        <locationY>1350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dtDone</name>
            <fieldText>&lt;p&gt;&lt;b&gt;All done.&lt;/b&gt; The Contact has been updated, a confirmation email was sent to {!inEmail}, and the case has been stamped with Closed Reason &quot;Closed - Email Sent&quot; - the existing Auto close case flow will close it.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_No_Contact</name>
        <label>No Contact matched</label>
        <locationX>440</locationX>
        <locationY>450</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dtNoContact</name>
            <fieldText>&lt;p&gt;&lt;b&gt;This case has no matched Contact.&lt;/b&gt; Match the correct supporter on the case first (check the supplied email address {!Get_Case.SuppliedEmail}), then relaunch this action. This flow never creates or guesses Contacts.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Review</name>
        <label>Update Supporter Details</label>
        <locationX>176</locationX>
        <locationY>625</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dtCurrent</name>
            <fieldText>&lt;p&gt;Updating &lt;b&gt;{!Get_Contact.FirstName} {!Get_Contact.LastName}&lt;/b&gt; ({!Get_Contact.Email}). Verify you are speaking with, or replying to, this supporter before saving changes. Current values are pre-filled - change only what the supporter asked for.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>dtWarnNPSP</name>
            <fieldText>&lt;p&gt;⚠ &lt;b&gt;This supporter has NPSP Recurring Donation records.&lt;/b&gt; Check receipting and mailing follow the new details.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Get_NPSP_Recurring</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>dtWarnAAkPay</name>
            <fieldText>&lt;p&gt;⚠ &lt;b&gt;This supporter has Payments2Us Recurring Payment records.&lt;/b&gt; Check direct debit correspondence follows the new details.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Get_AAkPay_Recurring</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
