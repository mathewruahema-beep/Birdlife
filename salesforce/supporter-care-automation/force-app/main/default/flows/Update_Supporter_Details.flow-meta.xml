<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Confirmation</name>
        <label>Send Confirmation Email</label>
        <locationX>176</locationX>
        <locationY>1100</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Update_Case</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>inEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>fConfirmSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>confirmBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>logEmailOnSend</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>Get_Case.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <decisions>
        <name>Address_Provided</name>
        <label>Address change requested?</label>
        <locationX>176</locationX>
        <locationY>800</locationY>
        <defaultConnector>
            <targetReference>Send_Confirmation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No address change</defaultConnectorLabel>
        <rules>
            <name>Yes_Address</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fHasAddress</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Apply_Address_Change</targetReference>
            </connector>
            <label>Address provided</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Contact</name>
        <label>Case has a matched Contact?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contact matched</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_NPSP_Recurring</targetReference>
            </connector>
            <label>Contact found</label>
        </rules>
    </decisions>
    <description>Guided resolve for Update Supporter Contact Details cases. Verifies the matched Contact, captures new values once, routes address changes through NPSP household addresses, warns on active regular giving (NPSP and Payments2Us) so mail follows the supporter, emails a confirmation, and stamps Sub Type and Closed Reason - the existing Auto close case flow then closes the case. DESIGN BUILD - deployed as Draft, do not activate without UAT.</description>
    <environments>Default</environments>
    <formulas>
        <name>fConfirmSubject</name>
        <dataType>String</dataType>
        <expression>"Your details have been updated (Case " &amp; {!Get_Case.CaseNumber} &amp; ")"</expression>
    </formulas>
    <formulas>
        <name>fHasAddress</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inStreet}))</expression>
    </formulas>
    <interviewLabel>Update Supporter Details {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Supporter Details</label>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_AAkPay_Recurring</name>
        <label>Get Payments2Us Recurring Payment</label>
        <locationX>176</locationX>
        <locationY>550</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Review</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AAkPay__Contact__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Contact.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AAkPay__Recurring_Payment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Case</name>
        <label>Get Case</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact</name>
        <label>Get Contact</label>
        <locationX>176</locationX>
        <locationY>225</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.ContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
