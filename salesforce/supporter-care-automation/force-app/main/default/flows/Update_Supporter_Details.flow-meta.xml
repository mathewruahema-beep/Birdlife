    <textTemplates>
        <name>confirmBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hello {!inFirstName},

Thank you for letting us know your new details. We have updated your record with BirdLife Australia (case {!Get_Case.CaseNumber}).

If anything looks wrong, just reply to this email and we will fix it straight away.

Warm regards,
BirdLife Australia Supporter Care</text>
    </textTemplates>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
