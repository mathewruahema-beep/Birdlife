    <decisions>
        <name>Can_Email_Donor</name>
        <label>Can we email the donor?</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <defaultConnector>
            <targetReference>Create_Rescue_Task_No_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No email possible - task only</defaultConnectorLabel>
        <rules>
            <name>Email_OK</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AAkPay__Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AAkPay__Contact__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AAkPay__Contact__r.npsp__Deceased__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AAkPay__Contact__r.HasOptedOutOfEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Payment_Failure_Email</targetReference>
            </connector>
            <label>Email OK</label>
        </rules>
    </decisions>
    <decisions>
        <name>Still_Suspended</name>
        <label>Still suspended after 14 days?</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Recovered or cancelled - no action</defaultConnectorLabel>
        <rules>
            <name>Yes_Still_Suspended</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_RP.AAkPay__Recurring_Payment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Suspended - Max retries exceeded</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Escalation_Task</targetReference>
            </connector>
            <label>Yes - still suspended</label>
        </rules>
    </decisions>
    <description>Regular Giving &amp; Membership Renewal Recovery. Fires when a Payments2Us Recurring Payment transitions to "Suspended - Max retries exceeded": emails the donor a self-service payment-update link (guarded for deceased/opt-out/no-email), creates a follow-up Task for the record owner, and escalates via a 14-day scheduled path if the payment is still suspended. Read-only against the Recurring Payment record; creates Tasks and sends one email only. Built 20 Aug 2026 as Draft - see docs/fundraising/02-automation-regular-giving-recovery.md for the activation gate.</description>
    <environments>Default</environments>
    <formulas>
        <name>DueIn3Days</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 3</expression>
    </formulas>
    <formulas>
        <name>DueIn7Days</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 7</expression>
    </formulas>
    <interviewLabel>RP aCU - Suspended Regular Giving Rescue {!$Flow.CurrentDateTime}</interviewLabel>
