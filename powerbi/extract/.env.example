# Copy to .env, fill in, and keep .env out of git (see ../../.gitignore).
# Never paste real values into a prompt, a routine, or a commit — the WooCommerce
# keys that leaked did so exactly that way.

# --- NetSuite -----------------------------------------------------------------
# Setup → Integration → Manage Integrations → New (get consumer key/secret),
# then Setup → Users/Roles → Access Tokens → New (get token id/secret).
# The role needs the "SuiteAnalytics Workbook" and "REST Web Services" permissions.
NS_ACCOUNT=1234567
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
NS_TOKEN_ID=
NS_TOKEN_SECRET=

# --- Salesforce ---------------------------------------------------------------
# Setup → App Manager → New Connected App → Enable OAuth, enable the
# client-credentials flow, and nominate a run-as user. Give that user a
# read-only profile — this extract never writes.
SF_DOMAIN=https://birdlifeaustralia.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
